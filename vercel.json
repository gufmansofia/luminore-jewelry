{
  "framework": null,
  "buildCommand": "bun run build",
  "installCommand": "bun install --frozen-lockfile",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "luminore-jewelry.vercel.app"
        }
      ],
      "destination": "https://www.luminorejewelry.com/$1",
      "permanent": true
    }
  ]
}
