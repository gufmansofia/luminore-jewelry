{
  "name": "luminore-jewelry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.tsx",
  "module": "src/index.tsx",
  "scripts": {
    "dev": "bun --hot src/index.tsx",
    "start": "NODE_ENV=production bun src/index.tsx",
    "build": "bun run build.ts",
    "check:assets": "bun run scripts/check-assets.ts",
    "test:catalogue": "bun test ./scripts/check-catalogue.ts && bun scripts/render-catalogue-check.tsx",
    "test:experience": "bun test ./scripts/check-experience.ts",
    "test:seo": "bun test ./scripts/check-seo.ts",
    "test:interactions": "bun test ./scripts/check-interactions.ts",
    "preview": "bun scripts/serve-built.ts",
    "test:mobile": "bun test ./scripts/check-mobile-improvements.ts",
    "test:video": "bun test ./scripts/check-video.ts ./scripts/check-autoplay.ts"
  },
  "dependencies": {
    "bun-plugin-tailwind": "^0.0.14",
    "react": "^19",
    "react-dom": "^19",
    "react-router-dom": "^7.13.0",
    "tailwindcss": "^4.0.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "playwright": "1.58.2"
  },
  "packageManager": "bun@1.3.9"
}
